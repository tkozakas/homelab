:80 {
    handle /hooks/* {
        reverse_proxy webhook:9000
    }

    handle /slack/* {
        reverse_proxy githuber:8080
    }

    redir /wordforge /wordforge/

    handle_path /wordforge/* {
        reverse_proxy wordforge:80
    }

    redir /arcade /arcade/

    handle_path /arcade/* {
        reverse_proxy arcade:8080
    }

    handle {
        reverse_proxy ghstats:80
    }
}
