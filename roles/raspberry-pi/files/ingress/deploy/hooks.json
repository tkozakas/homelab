  {
    "id": "deploy-sea-battle",
    "execute-command": "/scripts/deploy.sh",
    "command-working-directory": "{{ getenv "SVC_DIR" }}/sea-battle",
    "response-message": "Deployment triggered",
    "trigger-rule": {
      "or": [
        {
          "match": {
            "type": "value",
            "value": "{{ getenv "DEPLOY_TOKEN_SEA_BATTLE" | js }}",
            "parameter": { "source": "header", "name": "Authorization" }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "{{ getenv "DEPLOY_TOKEN" | js }}",
            "parameter": { "source": "header", "name": "Authorization" }
